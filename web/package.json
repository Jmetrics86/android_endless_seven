{
  "name": "endless-seven",
  "private": true,
  "version": "0.0.0",
  "description": "Endless Seven — Strategic card game. Choose Light or Darkness, command the Seals.",
  "author": "Endless Seven",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:android": "cross-env VITE_BASE=./ vite build --outDir ../app/src/main/assets/web",
    "android:debug": "npm run build:android && cd .. && gradlew.bat assembleDebug",
    "android:release": "npm run build:android && cd .. && gradlew.bat bundleRelease",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.14.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.1",
    "vite": "^6.4.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "wait-on": "^8.0.1",
    "vitest": "^3.2.6"
  }
}